# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Use SQLite by default (relative or absolute file path)
# For PostgreSQL: postgresql://username:password@localhost:5432/bookstore
DATABASE_URL=sqlite:./data/bookstore.db

# Authentication
JWT_SECRET=super-secret-pagecrafter-jwt-token-key-change-in-production-2026
JWT_EXPIRES_IN=7d

# CORS Configuration (comma-separated origins or * for all in development)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173

# Payment Configuration (optional - uses mock Stripe intent if unset)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

